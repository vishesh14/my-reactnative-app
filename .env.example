# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Variables prefixed with EXPO_PUBLIC_ are inlined into the app bundle — never put secrets in them.
# Learn more: https://docs.expo.dev/guides/environment-variables/

# Base URL for the backend API (used by src/services/api-client.ts)
EXPO_PUBLIC_API_URL=http://localhost:3000
